{
  "name": "@walnut/shared",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Shared utilities, constants, types, crypto and storage for Walnut Admin",
  "scripts": {
    "build": "echo 'shared: pure source, no build needed'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "vue-tsc --noEmit",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "idb": "8.0.3"
  },
  "peerDependencies": {
    "@vueuse/core": "14.3.0",
    "detectincognitojs": "1.6.2",
    "js-base64": "3.7.8",
    "lodash-es": "4.18.1",
    "nanoid": "5.1.11",
    "superjson": "2.2.6",
    "vue": "3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vite": "8.0.11",
    "vite-plugin-dts": "4.5.4"
  }
}
